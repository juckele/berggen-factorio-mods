{
  "factorio": "2.1",
  "mod_paths": {
    "vulcanus-demolisher-lifecycle": "../../mods/vulcanus-demolisher-lifecycle",
    "demolisher-lifecycle-test-setup": "mods/demolisher-lifecycle-test-setup",
    "demolisher-lifecycle-test-checks": "mods/demolisher-lifecycle-test-checks"
  },
  "scenarios": [
    {
      "name": "new-game",
      "description": "Mod present from a fixed-seed new game; Vulcanus created mid-game; a demolisher killed; its cleared land is retaken by neighbours while the starting area stays protected.",
      "settings": { "demolisher-lifecycle-expansion-interval-ticks": 5 },
      "steps": [
        {
          "phase": "new-game-create",
          "create": { "seed": 12345 },
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        },
        {
          "phase": "new-game-run",
          "benchmark": 2400,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "unprotected",
      "description": "Mod added to the established save with starting-area protection off: territory grows into the starting area. On a server (mod added fresh again, since benchmark steps don't save), turning protection on stops further growth without evicting.",
      "settings": {
        "demolisher-lifecycle-expansion-interval-ticks": 60,
        "demolisher-lifecycle-protect-starting-area": false
      },
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "unprotected-add",
          "benchmark": 1600,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        },
        {
          "phase": "toggle-protection",
          "server": {
            "actions": [
              { "wait": 600 },
              {
                "lua": "settings.global['demolisher-lifecycle-protect-starting-area'] = {value = true}",
                "context": "vulcanus-demolisher-lifecycle"
              },
              {
                "name": "protection-enabled",
                "lua": "rcon.print(settings.global['demolisher-lifecycle-protect-starting-area'].value)",
                "expect": "^true"
              },
              { "wait": 660 }
            ]
          },
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "established",
      "description": "Vulcanus visited and built on before the mod is added.",
      "settings": { "demolisher-lifecycle-expansion-interval-ticks": 60 },
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "established-add",
          "benchmark": 600,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "map-settings",
      "description": "No interval override: the expansion cooldown follows the map's enemy expansion settings, shortened by evolution with vanilla's formula, and stops when map expansion is off.",
      "settings": { "demolisher-lifecycle-expansion-interval-ticks": 0 },
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "map-settings-add",
          "benchmark": 12700,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "nests",
      "description": "Growth respects the distance gate; a max-size demolisher travels to its territory centre, coils, lays 4 eggs and resumes patrol; eggs hatch by age (one parent chunk), by free space (a parent chunk next to cleared land), or after the parent dies (the reserved nest chunk); a destroyed egg is removed.",
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "nests-add",
          "benchmark": 14100,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "nests-natural",
      "description": "All four events on their own fast clocks with low thresholds and a few kills: demolishers grow, nest and hatch, and every territory keeps exactly one demolisher.",
      "settings": { "demolisher-lifecycle-expansion-interval-ticks": 10 },
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "nests-natural-add",
          "benchmark": 16000,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "nest-interrupt",
      "description": "Damaging a demolisher while it coils ends its nesting trip without a nest, and it doesn't immediately retry.",
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "nest-interrupt-add",
          "benchmark": 9600,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "killed",
      "description": "Demolishers killed before the mod is added: their territories are removed and marked cleared, living neighbours retake the land (explored or not) at the default rate, and exploring it spawns nothing.",
      "steps": [
        {
          "phase": "killed-setup",
          "fixture": "killed-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "kill": 3 },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "killed-add",
          "benchmark": 3600,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    }
  ]
}
