{
  "factorio": "2.1",
  "mod_paths": {
    "vulcanus-demolisher-lifecycle": "../../mods/vulcanus-demolisher-lifecycle",
    "demolisher-lifecycle-test-setup": "mods/demolisher-lifecycle-test-setup",
    "demolisher-lifecycle-test-checks": "mods/demolisher-lifecycle-test-checks"
  },
  "scenarios": [
    {
      "name": "new-game",
      "description": "Mod present from a fixed-seed new game; Vulcanus created mid-game; a demolisher killed; neighbouring territories expand into its cleared land while the starting area stays protected.",
      "settings": { "demolisher-lifecycle-expansion-interval-ticks": 5 },
      "steps": [
        {
          "phase": "new-game-create",
          "create": { "seed": 12345 },
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        },
        {
          "phase": "new-game-run",
          "benchmark": 2400,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
    {
      "name": "unprotected",
      "description": "Mod added to the established save with starting-area protection off: territory grows into the starting area. On a server (mod added fresh again, since benchmark steps don't save), turning protection on stops further growth without evicting.",
      "settings": {
        "demolisher-lifecycle-expansion-interval-ticks": 60,
        "demolisher-lifecycle-protect-starting-area": false
      },
      "steps": [
        {
          "phase": "established-setup",
          "fixture": "established-start",
          "create": { "seed": 12345 },
          "params": { "vulcanus_radius": 12, "build": true },
          "mods": ["demolisher-lifecycle-test-setup"],
          "expect_done": true
        },
        {
          "phase": "unprotected-add",
          "benchmark": 1600,
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        },
        {
          "phase": "toggle-protection",
          "server": {
            "actions": [
              { "wait": 600 },
              {
                "lua": "settings.global['demolisher-lifecycle-protect-starting-area'] = {value = true}",
                "context": "vulcanus-demolisher-lifecycle"
              },
              {
                "name": "protection-enabled",
                "lua": "rcon.print(settings.global['demolisher-lifecycle-protect-starting-area'].value)",
                "expect": "^true"
              },
              { "wait": 660 }
            ]
          },
          "mods": ["vulcanus-demolisher-lifecycle", "demolisher-lifecycle-test-setup", "demolisher-lifecycle-test-checks"],
          "expect_done": true
        }
      ]
    },
